{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fashionstorebackend-u5nu.onrender.com//api/:path*"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
